false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335557856&quot;:16777215,&quot;335559685&quot;:720,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:220,&quot;335559740&quot;:240,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul> <ul> <li data-leveltext=\"●\" data-font=\"Poppins\" data-listid=\"3\"\ndata-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;●&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\"\ndata-aria-posinset=\"11\" data-aria-level=\"1\"><span data-contrast=\"none\">Ability\nto work in a team</span><span\ndata-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335557856&quot;:16777215,&quot;335559685&quot;:720,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:220,&quot;335559740&quot;:240,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul> <ul> <li data-leveltext=\"●\" data-font=\"Poppins\" data-listid=\"3\"\ndata-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;●&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\"\ndata-aria-posinset=\"12\" data-aria-level=\"1\"><span\ndata-contrast=\"none\">Outstanding analytical and problem-solving\nskills</span><span\ndata-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335557856&quot;:16777215,&quot;335559685&quot;:720,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:220,&quot;335559740&quot;:240,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul> <p><span\ndata-ccp-props=\"{&quot;335559685&quot;:720}\">&nbsp;</span><strong><span\nda